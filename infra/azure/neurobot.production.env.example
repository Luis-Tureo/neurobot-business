NODE_ENV=production
PANEL_HOST=127.0.0.1
PANEL_PORT=3001
DATABASE_PATH=/var/lib/neurobot/data/neurobot.db
LOG_LEVEL=info

# Generated outside the repository by scripts/new-production-env.ps1.
ANONYMIZATION_SECRET=
PANEL_SESSION_SECRET=
PANEL_INITIAL_PASSWORD=
APP_ENCRYPTION_KEY=

MAX_MESSAGE_LENGTH=2000
MAX_RECONNECT_ATTEMPTS=8
MAX_RECONNECT_DELAY_SECONDS=300
DEVELOPMENT_MODE=false

# Fill these values only in the external environment file.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0
META_REQUEST_TIMEOUT_MS=10000
META_WHATSAPP_ACCOUNTS_JSON=

AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
