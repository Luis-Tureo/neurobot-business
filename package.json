{
  "name": "neurobot-business",
  "version": "0.1.0",
  "private": true,
  "description": "Asistente de WhatsApp exclusivo para negocios y atención al cliente privada.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "build:css": "tailwindcss -i ./src/admin/panel.css -o ./public/panel.css --minify",
    "dev:css": "tailwindcss -i ./src/admin/panel.css -o ./public/panel.css --watch",
    "predev": "npm run setup && npm run build:css",
    "dev": "tsx src/index.ts",
    "predev:watch": "npm run setup && npm run build:css",
    "dev:watch": "tsx watch src/index.ts",
    "build": "npm run build:css && tsc -p tsconfig.build.json",
    "prestart": "npm run setup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "smoke": "tsx scripts/smoke.ts",
    "db:init": "tsx scripts/init-db.ts",
    "admin:reset": "tsx scripts/reset-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "8.0.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/static": "10.1.2",
    "better-sqlite3": "13.0.2",
    "dotenv": "17.4.2",
    "fastify": "5.11.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "better-sqlite3@13.0.2": true
  }
}
