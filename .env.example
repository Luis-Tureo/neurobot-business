NODE_ENV=development

# Panel administrativo y persistencia local.
PANEL_HOST=127.0.0.1
PANEL_PORT=3001
DATABASE_PATH=./data/asistente-negocio.db
LOG_LEVEL=info

# Genere valores aleatorios largos y únicos. Nunca use estos ejemplos en producción.
ANONYMIZATION_SECRET=reemplace-por-un-secreto-aleatorio-de-al-menos-32-caracteres
PANEL_SESSION_SECRET=reemplace-por-otro-secreto-aleatorio-de-al-menos-32-caracteres
PANEL_INITIAL_PASSWORD=

MAX_MESSAGE_LENGTH=2000
MAX_RECONNECT_ATTEMPTS=8
MAX_RECONNECT_DELAY_SECONDS=300
DEVELOPMENT_MODE=false

# WhatsApp Cloud API oficial. Obtenga estos valores en Meta Developers.
# META_ACCESS_TOKEN, META_APP_SECRET y META_WEBHOOK_VERIFY_TOKEN son secretos.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0
META_REQUEST_TIMEOUT_MS=10000

# Alternativa multibot. Si se usa, omita las tres variables de cuenta simples anteriores.
# Ejemplo ficticio en una sola línea:
# [{"botId":"mi-negocio","accessToken":"token-ficticio-de-al-menos-20-caracteres","phoneNumberId":"123456789012345","wabaId":"987654321098765"}]
META_WHATSAPP_ACCOUNTS_JSON=

# Inteligencia opcional. Cada instalación debe utilizar su propia clave.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
APP_ENCRYPTION_KEY=
