# El panel solo escucha en localhost de forma predeterminada.
PANEL_HOST=127.0.0.1
PANEL_PORT=3001
DATABASE_PATH=./data/asistente-negocio.db
LOG_LEVEL=info

# Ruta heredada conservada temporalmente para recuperación durante la migración.
# Neurobot Business ya no utiliza una sesión QR cuando funciona con Meta Cloud API.
WHATSAPP_SESSION_PATH=./data/whatsapp-session-negocio

# Genere un valor aleatorio largo y único. Nunca use este ejemplo en producción.
ANONYMIZATION_SECRET=reemplace-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# Opcional en el primer inicio. Si se omite, se muestra una contraseña temporal una sola vez.
PANEL_INITIAL_PASSWORD=
PANEL_SESSION_SECRET=reemplace-por-otro-secreto-aleatorio-de-al-menos-32-caracteres

USER_RATE_LIMIT=3
GROUP_RATE_LIMIT=10
RATE_WINDOW_SECONDS=60
USER_COOLDOWN_SECONDS=5
REPEAT_WINDOW_SECONDS=120
MAX_MESSAGE_LENGTH=2000
MAX_RECONNECT_ATTEMPTS=8
MAX_RECONNECT_DELAY_SECONDS=300
DEVELOPMENT_MODE=false

# Compatibilidad temporal con componentes heredados. No es necesario para Meta Cloud API.
CHROME_EXECUTABLE_PATH=

# Conexión oficial con WhatsApp Business Platform.
# Estos valores se obtienen desde la aplicación y la cuenta empresarial configuradas en Meta.
META_GRAPH_API_VERSION=v25.0
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_BILLING_LEDGER_PATH=./data/meta-billing-events.jsonl

# Plan administrado exclusivamente por el proveedor de Neurobot.
# BASIC: solo respuestas dentro de la ventana de atención de 24 horas.
# ADVANCED: permite plantillas aprobadas y requiere un presupuesto previamente aceptado.
COMMERCIAL_PLAN=BASIC
COMMERCIAL_QUOTE_REFERENCE=

# Inteligencia opcional. Cada instalación debe utilizar su propia clave; nunca la comparta.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
APP_ENCRYPTION_KEY=
